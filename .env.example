# Required server configuration
API_URL=https://api.example.com/v1/
COOKIE_SECRET=replace-with-at-least-32-random-characters
ACS_JWT_SECRET=replace-with-the-backend-access-token-signing-secret

# Newsletter provider
KEILA_URL=https://newsletter.example.com/api/v1/contacts
KEILA_TKN=replace-with-a-keila-api-token

# Local-only preview routes. Keep false in production.
ENABLE_PREVIEW_ROUTES=false

# Build-time Sentry source-map upload (optional)
SENTRY_AUTH_TOKEN=
